LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_PUBLIC_WS_URL=wss://YOUR_DOMAIN/livekit
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
ROOM_NAME=onzsm
PORT=8080
INGEST_TCP_PORT=8081
# Set to "true" to serve bot.html/bot.js (solo calibration tool). Leave unset
# in production: it lets anyone publish a fake audio track into the room.
ENABLE_CALIBRATION_BOT=false
# Set to "true" to allow the ?debug=1 panel: live peer table, event log, follow
# offset sliders, the manual "type your own login" join, and a room picker.
#
# Read this before turning it on. It makes /token?identity=<anything> answer,
# and lets that caller name the room. Anyone who loads the site can then join
# ANY room under ANY name and listen to the people in it. There is no password
# on it — the switch IS the password. It exists for developing and testing the
# project (and for forks doing the same), not for a published relay: turn it on
# while you test, turn it back off before you tell players about the site.
#
# The browser asks the server (GET /config.js) whether debug is allowed, so
# leaving this false really closes the door, it doesn't just hide the panel.
DEBUG_MODE=false
# Remaining piece of the security model: shared token required before the raw
# TCP ingest port (8081) accepts nonce/position messages. Doesn't identify
# individual players — just raises the bar from "anyone on the internet" to
# "someone who has this token" (e.g. shared in your community's Discord).
# Leave blank to disable the check (local dev default).
#
# The plugin exchanges this value for a short-lived, single-use token over
# HTTPS (POST /tcp-auth, same host as your web client) and normally only ever
# writes that disposable token to the plaintext TCP socket. A legacy path
# still accepts the permanent secret directly on port 8081 too (kept for
# simulate-positions.js and older plugin builds); it shares the same
# per-IP rate limit as /tcp-auth, but prefer the token exchange when
# possible. Players set the plugin's "Relay secret" field (visible directly
# in the OnZVoIP plugin window) to this value.
TCP_SHARED_SECRET=

# Optional tuning knobs — all fall back to sensible defaults in relay.js when
# unset. Only worth touching for a large community (raise
# TCP_MAX_CONNECTIONS) or a slower VPS (raise the interval knobs to spend
# less CPU on broadcasts).
# TCP_MAX_CONNECTIONS=1000
# TCP_IDLE_TIMEOUT_MS=30000
# POSITION_BROADCAST_INTERVAL_MS=100
# STATE_PUSH_INTERVAL_MS=5000

# --- Running an event -------------------------------------------------------
# Where connect/disconnect/report events are appended, one JSON object per
# line. Leave blank and they still reach stdout (journalctl keeps them), they
# just aren't re-readable by the relay for /admin. Rotates at 32 MB, keeps one
# previous file. Contains logins, room names and timestamps — no positions,
# no audio. Delete it when the event is over if you don't want to keep it.
EVENT_LOG_FILE=
# Where the ban list (Actions tab of /admin) is kept. Unlike a block, a ban has
# no expiry and must survive a restart — leave this blank and the list dies
# with the process, which for names typed in the day before an event means it
# is gone by the time it matters. The directory must exist and be writable.
# BAN_FILE=/var/lib/onzvoip/bans.json
BAN_FILE=
# Live dashboard at /admin: who is connected, on which plugin version, who is
# missing their browser half, plus reports sent from the web client. Both must
# be set or the page does not exist at all (404, not 401) — a half-configured
# password is worse than no page. Basic auth, so only serve it over HTTPS.
ADMIN_USER=
ADMIN_PASSWORD=
# Set to "true" to add buttons to /admin: flip DEBUG_MODE live, toggle the
# ghost auto-kick, disconnect a stuck LiveKit participant, and manage teams
# (group players by colour, let a team hear each other across the whole map).
# Off by default —
# with it on, whoever has the admin password can change how the relay behaves,
# not just look at it. Worth it during an event you are running yourself.
# When false the endpoints answer 404 and the page draws no buttons at all.
ADMIN_ACTIONS=false
# Set to "true" to allow starting fake plugin clients from /admin (Bots tab).
# They connect back to INGEST_TCP_PORT and send real position messages under
# invented logins, which is exactly what the TCP port is meant to keep out —
# so this is for load-testing your own relay ("does it hold at 30 players?"),
# never for a published one. Needs ADMIN_ACTIONS=true too.
ENABLE_TEST_BOTS=false
