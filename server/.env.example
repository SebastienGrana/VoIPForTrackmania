LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_PUBLIC_WS_URL=wss://YOUR_DOMAIN/livekit
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
ROOM_NAME=onzsm
PORT=8080
INGEST_TCP_PORT=8081
# Set to "true" to serve bot.html/bot.js (solo calibration tool). Leave unset
# in production: it lets anyone publish a fake audio track into the room.
ENABLE_CALIBRATION_BOT=false
# Sécurité restante: shared token required as the first message on the raw TCP
# ingest port (8081) before it accepts nonce/position messages. Doesn't
# identify individual players — just raises the bar from "anyone on the
# internet" to "someone who has this token" (e.g. shared in your community's
# Discord). Leave blank to disable the check (local dev default). Players
# using the OpenPlanet plugin must set the same value in Settings → Plugins →
# OnZVoIP → "Relay secret".
TCP_SHARED_SECRET=
