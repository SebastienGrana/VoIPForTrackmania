# Used by docker-compose.yml (auto-loaded from a ".env" file in this
# directory — copy this file to ".env" and edit).
#
# LiveKit advertises this address to WebRTC clients as the media (RTC) IP.
# 127.0.0.1 only works for a single machine talking to itself. To test from
# another device on your LAN (e.g. the game running elsewhere), set this to
# your machine's LAN IP (ipconfig / ip addr).
LIVEKIT_NODE_IP=127.0.0.1
